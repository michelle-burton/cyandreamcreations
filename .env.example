# Public Square Sandbox values. These are included in the browser bundle.
VITE_SQUARE_ENV=sandbox
VITE_SQUARE_APP_ID=your-sandbox-application-id
VITE_SQUARE_LOCATION_ID=L9WBEC89PMHV3
# Set this only in production to send customers to the live Square-hosted checkout.
VITE_SQUARE_CHECKOUT_URL=

# Server-only values. Never prefix the access token with VITE_.
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=your-sandbox-access-token
SQUARE_LOCATION_ID=L9WBEC89PMHV3

# Production payments stay blocked until shipping and tax are finalized.
ALLOW_PRODUCTION_PAYMENTS=false
